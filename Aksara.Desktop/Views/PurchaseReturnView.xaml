<UserControl x:Class="Aksara.Desktop.Views.PurchaseReturnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             PreviewKeyDown="Root_PreviewKeyDown">
    <Grid Background="{StaticResource CanvasBrush}" ClipToBounds="True">
        <Grid.RowDefinitions><RowDefinition Height="31"/><RowDefinition Height="83"/><RowDefinition Height="*"/><RowDefinition Height="118"/><RowDefinition Height="32"/><RowDefinition Height="29"/></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="7,2"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                <CheckBox Content="Exclusive Mode" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Status:" VerticalAlignment="Center"/>
                <TextBlock x:Name="ModeStatusText" Grid.Column="2" Text="TRANSAKSI BARU" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <Border Grid.Row="1" Margin="8,5,8,2" Style="{StaticResource CardStyle}" Padding="6,2">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition Width="120"/><ColumnDefinition Width="70"/><ColumnDefinition Width="150"/><ColumnDefinition Width="65"/><ColumnDefinition Width="120"/><ColumnDefinition Width="65"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="24"/><RowDefinition Height="24"/></Grid.RowDefinitions>
                <TextBlock Text="Tgl.Retur" VerticalAlignment="Center"/><DatePicker x:Name="ReturnDatePicker" Grid.Column="1" SelectedDate="{Binding ReturnDate}" FontSize="11"/>
                <TextBlock Grid.Column="2" Text="No.Faktur" VerticalAlignment="Center"/><TextBox x:Name="SourceNumberBox" Grid.Column="3" PreviewKeyDown="SourceNumberBox_PreviewKeyDown" MouseDoubleClick="SourceNumberBox_MouseDoubleClick" ToolTipService.InitialShowDelay="120" ToolTip="F4 / double-click membuka daftar Faktur Pembelian"/>
                <TextBlock Grid.Column="4" Text="Trans." VerticalAlignment="Center"/><TextBox x:Name="TransactionTypeBox" Grid.Column="5" IsReadOnly="True" Style="{StaticResource ReadOnlyTextBoxStyle}"/>
                <TextBlock Grid.Column="6" Text="Gudang" VerticalAlignment="Center"/><TextBox x:Name="WarehouseBox" Grid.Column="7" IsReadOnly="True" Style="{StaticResource ReadOnlyTextBoxStyle}"/>
                <TextBlock Grid.Row="1" Text="No.Retur" VerticalAlignment="Center"/><TextBox x:Name="ReturnNumberBox" Grid.Row="1" Grid.Column="1" CharacterCasing="Upper" TextChanged="ReturnNumberBox_TextChanged"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Kode Supl." VerticalAlignment="Center"/><TextBox x:Name="SupplierCodeBox" Grid.Row="1" Grid.Column="3" IsReadOnly="True" Style="{StaticResource ReadOnlyTextBoxStyle}"/>
                <TextBlock Grid.Row="1" Grid.Column="4" Text="Toko/PT" VerticalAlignment="Center"/><TextBox x:Name="SupplierNameBox" Grid.Row="1" Grid.Column="5" Grid.ColumnSpan="3" IsReadOnly="True" Style="{StaticResource ReadOnlyTextBoxStyle}"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Alamat" VerticalAlignment="Center"/><TextBox x:Name="AddressBox" Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="5" IsReadOnly="True" Style="{StaticResource ReadOnlyTextBoxStyle}"/>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="8,0"><Grid.RowDefinitions><RowDefinition Height="31"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                <TabControl><TabItem Header="Rincian"/><TabItem Header="Catatan"/></TabControl>
                <Border Grid.Column="1" BorderBrush="#E7BDB7" BorderThickness="1" Background="#FFF4F2" Margin="5,2,0,2"><TextBlock Text="RETUR PEMBELIAN" Foreground="#B42318" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            </Grid>
            <DataGrid x:Name="LinesGrid" Grid.Row="1" ItemsSource="{Binding Lines}" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="23" ColumnHeaderHeight="27" CellEditEnding="LinesGrid_CellEditEnding" BeginningEdit="LinesGrid_BeginningEdit" PreviewKeyDown="LinesGrid_PreviewKeyDown" MouseDoubleClick="LinesGrid_MouseDoubleClick" ToolTipService.InitialShowDelay="120" ToolTip="Pilih faktur dulu. Setelah barang muncul, double-click baris untuk mengisi jumlah retur.">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Lok." Binding="{Binding WarehouseCode}" Width="48" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Kode Barang" Binding="{Binding ItemCode}" Width="110" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Nama Barang" Binding="{Binding ItemName}" Width="*" MinWidth="170" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Beli" Binding="{Binding PurchasedQuantity, StringFormat=N2}" Width="55" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Retur Lalu" Binding="{Binding PreviouslyReturned, StringFormat=N2}" Width="65" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Sisa" Binding="{Binding RemainingQuantity, StringFormat=N2}" Width="55" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Retur" Binding="{Binding ReturnQuantity, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="58"/>
                    <DataGridTextColumn Header="Sat." Binding="{Binding Unit}" Width="38" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Harga" Binding="{Binding UnitPrice, StringFormat=N2}" Width="75" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Disc." Binding="{Binding DiscountPercent, StringFormat=N2}" Width="50" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Jumlah" Binding="{Binding Total, StringFormat=N2}" Width="85" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <Grid Grid.Row="3" Margin="8,5,8,0" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="205"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,6,0" CornerRadius="3">
                <Grid Margin="8,3,8,6">
                    <Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Catatan" VerticalAlignment="Center"/>
                    <TextBox x:Name="NotesBox" Grid.Row="1" AcceptsReturn="True" BorderThickness="0" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,6,0" CornerRadius="3">
                <Grid Margin="10,3,10,6">
                    <Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Disc. Retur" VerticalAlignment="Center"/>
                    <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/></Grid.RowDefinitions>
                    <TextBlock Text="Percent" VerticalAlignment="Center"/><TextBox x:Name="DiscountPercentBox" Grid.Column="1" Text="0" HorizontalContentAlignment="Right" TextChanged="TotalsInput_TextChanged"/>
                    <TextBlock Grid.Row="1" Text="Rp." VerticalAlignment="Center"/><TextBox x:Name="DiscountAmountBox" Grid.Row="1" Grid.Column="1" Text="0" HorizontalContentAlignment="Right" TextChanged="TotalsInput_TextChanged"/>
                    <TextBlock Grid.Row="2" Text="Tot." VerticalAlignment="Center"/><TextBlock x:Name="DiscountTotalBox" Grid.Row="2" Grid.Column="1" Text="0,00" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0" CornerRadius="3">
                <Grid Margin="12,3,14,6">
                    <Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Total Retur" VerticalAlignment="Center"/>
                    <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="95"/><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="24"/></Grid.RowDefinitions>
                    <TextBlock Text="PPN %" VerticalAlignment="Center"/><TextBox x:Name="TaxPercentBox" Grid.Column="1" Text="0" HorizontalContentAlignment="Right" TextChanged="TotalsInput_TextChanged"/>
                    <TextBlock Grid.Row="1" Text="Netto" VerticalAlignment="Center"/><TextBlock x:Name="NetBox" Grid.Row="1" Grid.Column="3" Text="0,00" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="2" Text="Total" VerticalAlignment="Center" FontWeight="Bold"/><TextBlock x:Name="GrandTotalBox" Grid.Row="2" Grid.Column="3" Text="0,00" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="13" FontWeight="Bold"/>
                </Grid>
                </Grid>
            </Border>
        </Grid>
        <UniformGrid Grid.Row="4" Rows="1" Columns="10" Margin="8,3,8,0" MinHeight="28">
            <Button x:Name="ReturnSearchButton" Content="Cari" Click="SearchReturn_Click" ToolTipService.InitialShowDelay="120" ToolTip="Buka retur pembelian yang sudah tersimpan"/>
            <Button x:Name="SourceButton" Content="Pilih Faktur" Click="SearchSource_Click" ToolTipService.InitialShowDelay="120" ToolTip="Pilih faktur pembelian sumber retur"/>
            <Button x:Name="ItemButton" Content="Pilih Barang" Click="SelectReturnItem_Click" ToolTipService.InitialShowDelay="120" ToolTip="Pilih barang dari faktur yang akan diretur"/>
            <Button x:Name="AddButton" Content="Tambah" Click="Add_Click" ToolTipService.InitialShowDelay="120" ToolTip="Mulai retur baru"/>
            <Button x:Name="ResetButton" Content="Batal" Click="Reset_Click" ToolTipService.InitialShowDelay="120" ToolTip="Batalkan isian yang belum disimpan"/>
            <Button x:Name="SaveButton" Content="Simpan" Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click" ToolTipService.InitialShowDelay="120" ToolTip="Simpan retur, kurangi stok, dan posting jurnal"/>
            <Button x:Name="SavePrintButton" Content="Smpn&amp;Ctk" Click="SavePrint_Click" ToolTipService.InitialShowDelay="120" ToolTip="Simpan lalu cetak retur, atau cetak retur yang sedang dibuka"/>
            <Button x:Name="DeleteButton" Content="Hapus" Style="{StaticResource DangerButtonStyle}" Click="Delete_Click" ToolTipService.InitialShowDelay="120" ToolTip="Tandai hapus retur yang sudah tersimpan"/>
            <Button x:Name="RestoreButton" Content="Btl.Hapus" Click="Restore_Click" ToolTipService.InitialShowDelay="120" ToolTip="Batalkan tanda hapus retur"/>
            <Button x:Name="CloseButton" Content="Tutup" Click="Close_Click" ToolTipService.InitialShowDelay="120" ToolTip="Tutup form retur"/>
        </UniformGrid>
        <Border Grid.Row="5" Background="#F7FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,0"><TextBlock x:Name="HelpText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="ⓘ F4 / ENTER / double-click pada No.Faktur untuk memilih pembelian sumber."/></Border>
    </Grid>
</UserControl>

