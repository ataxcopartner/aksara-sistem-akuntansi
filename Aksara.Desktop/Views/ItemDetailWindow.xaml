<Window x:Class="Aksara.Desktop.Views.ItemDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Master Barang" Height="620" Width="780" MinHeight="580" MinWidth="720"
        Icon="pack://application:,,,/Assets/aksara.ico"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner" Background="#F0F0F0">
    <Grid Margin="5">
        <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="135"/><RowDefinition Height="*"/><RowDefinition Height="24"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Background="#ECECEC">
            <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition/><ColumnDefinition Width="150"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
            <CheckBox Content="Exclusive Mode" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <TextBlock x:Name="StatusText" Grid.Column="1" Text="Status:" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <TextBlock x:Name="ModeText" Grid.Column="2" Text="TAMBAH DATA" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Button Grid.Column="3" Content="|||" Height="27" Margin="4" Padding="0" Click="Close_Click" ToolTip="Tutup form"/>
        </Grid>
        <Grid Grid.Row="1" Margin="8,5,8,3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="145"/><ColumnDefinition Width="88"/><ColumnDefinition Width="220"/><ColumnDefinition Width="38"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition Height="25"/><RowDefinition Height="25"/><RowDefinition Height="25"/><RowDefinition x:Name="CostRow" Height="25"/></Grid.RowDefinitions>
            <TextBlock Text="Kode" VerticalAlignment="Center"/><TextBox x:Name="CodeBox" Grid.Column="1" Margin="3,1"/>
            <TextBlock Grid.Row="1" Text="Nama" VerticalAlignment="Center"/><TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5" Margin="3,1"/>
            <TextBlock x:Name="UnitLabel" Grid.Row="2" Text="Sat." VerticalAlignment="Center"/><TextBox x:Name="UnitBox" Grid.Row="2" Grid.Column="1" Margin="3,1" IsReadOnly="True" Cursor="Hand" ToolTip="Klik untuk memilih satuan" PreviewMouseLeftButtonDown="UnitLookup_MouseLeftButtonDown" PreviewKeyDown="UnitLookup_KeyDown"/>
            <TextBlock x:Name="CategoryLabel" Grid.Row="3" Grid.ColumnSpan="2" Text="Barang masuk Kel.Barang" VerticalAlignment="Center"/>
            <ComboBox x:Name="CategoryBox" Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="4" Margin="3,1" DisplayMemberPath="Name" SelectedValuePath="Code"/>
            <TextBlock x:Name="PurchasePriceLabel" Grid.Row="4" Text="Harga Beli" VerticalAlignment="Center"/><TextBox x:Name="PurchasePriceBox" Grid.Row="4" Grid.Column="1" Margin="3,1" Text="0" TextAlignment="Right"/>
            <TextBlock x:Name="AverageCostLabel" Grid.Row="4" Grid.Column="2" Text="HPP Standar" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBox x:Name="AverageCostBox" Grid.Row="4" Grid.Column="3" Margin="3,1" Text="0" TextAlignment="Right"/>
            <CheckBox x:Name="CheckStockBox" Grid.Row="4" Grid.Column="4" Grid.ColumnSpan="2" Content="Cek Stok" IsChecked="True" VerticalAlignment="Center" Margin="6,0,0,0"/>
            <TextBox x:Name="RackBox" Visibility="Collapsed"/><TextBox x:Name="BarcodeBox" Visibility="Collapsed"/><TextBox x:Name="BrandBox" Visibility="Collapsed"/><CheckBox x:Name="ActiveBox" IsChecked="True" Visibility="Collapsed"/>
        </Grid>
        <Grid Grid.Row="2" Margin="2,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="1.28*"/></Grid.ColumnDefinitions>
            <Grid x:Name="MainDetailPanel" Grid.Column="0">
                <Grid.RowDefinitions><RowDefinition Height="205"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <GroupBox x:Name="PricingGroup" Header="Harga Jual &amp; Discount Menurut Jumlah pengambilan Barang" Margin="0,0,4,3">
                    <Grid Margin="4">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="0.82*"/><ColumnDefinition Width="1.05*"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="PriceColumnLabel" Grid.Column="1" Text="Harga" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock x:Name="DiscountColumnLabel" Grid.Column="2" Text="Disc." FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock x:Name="QuantityColumnLabel" Grid.Column="3" Text="Quantity" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <DataGrid x:Name="PriceGrid" Grid.Row="1" Grid.ColumnSpan="4" ItemsSource="{Binding Prices}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="None" GridLinesVisibility="All" RowHeight="24" Margin="0,2,0,0">
                            <DataGrid.Columns><DataGridTextColumn Binding="{Binding TierName}" IsReadOnly="True" Width="1.3*"/><DataGridTextColumn Binding="{Binding Price, UpdateSourceTrigger=PropertyChanged}" Width="1*"/><DataGridTextColumn Binding="{Binding DiscountPercent, UpdateSourceTrigger=PropertyChanged}" Width="0.82*"/><DataGridTextColumn Binding="{Binding MinimumQuantity, UpdateSourceTrigger=PropertyChanged}" Width="1.05*"/></DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="PricingHintText" Grid.Row="2" Grid.ColumnSpan="4" Text="Catatan: Quantity untuk harga eceran berfungsi sebagai batas minimum." FontSize="10" TextWrapping="Wrap" Margin="2,2,0,0"/>
                    </Grid>
                </GroupBox>
                <TabControl x:Name="ItemDetailsTabs" Grid.Row="1" Margin="0,3,4,0">
                    <TabItem x:Name="MaterialsTab" Header="Bahan"><Grid Margin="3"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid x:Name="FormulaGrid" ItemsSource="{Binding Formula}" AutoGenerateColumns="False" CanUserAddRows="True" RowHeight="22"><DataGrid.Columns><DataGridTextColumn Header="Kode Bahan" Binding="{Binding ComponentItemCode}" Width="150"/><DataGridTextColumn Header="Nama Bahan" Binding="{Binding ComponentItemName}" Width="*"/><DataGridTextColumn Header="Jumlah" Binding="{Binding Quantity}" Width="90"/><DataGridTextColumn Header="Sat." Binding="{Binding Unit}" Width="55"/></DataGrid.Columns></DataGrid><Button Grid.Row="1" Content="Hapus Baris Terpilih" HorizontalAlignment="Right" Margin="0,3,0,0" Padding="7,2" Click="RemoveFormula_Click"/></Grid></TabItem>
                    <TabItem x:Name="WorkforceTab" Header="Tenaga Kerja"><TextBlock x:Name="WorkforceHintText" Text="Belum ada rincian tenaga kerja untuk barang ini." Foreground="#555" Margin="8"/></TabItem>
                    <TabItem x:Name="OverheadTab" Header="Overhead"><TextBlock x:Name="OverheadHintText" Text="Belum ada rincian overhead untuk barang ini." Foreground="#555" Margin="8"/></TabItem>
                    <TabItem x:Name="NotesTab" Header="Catatan &amp; Ket./Spek"><Grid Margin="4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><GroupBox Header="Catatan" Margin="0,0,3,0"><TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" Padding="6,5"/></GroupBox><GroupBox Grid.Column="1" Header="Keterangan / Spesifikasi" Margin="3,0,0,0"><TextBox x:Name="SpecificationBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" Padding="6,5"/></GroupBox></Grid></TabItem>
                    <TabItem Header="Gambar"><Grid Margin="5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><Border BorderBrush="#AAA" BorderThickness="1" Background="White"><Image x:Name="ItemImage" Stretch="Uniform"/></Border><StackPanel Grid.Column="1" Margin="7,0,0,0"><Button Content="Pilih Gambar..." Margin="0,0,0,4" Click="LoadImage_Click"/><Button Content="Hapus Gambar" Click="RemoveImage_Click"/></StackPanel></Grid></TabItem>
                </TabControl>
            </Grid>
            <StackPanel x:Name="InventorySidePanel" Grid.Column="1" Margin="4,0,0,0">
                <GroupBox Header="Koli (Kemasan Besar)" Height="105" Margin="0,0,0,4"><Grid Margin="5"><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="24"/><RowDefinition Height="24"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><TextBlock Text="Nama" VerticalAlignment="Center"/><TextBox x:Name="PackageNameBox" Grid.Column="1" Margin="3,1" IsReadOnly="True" Cursor="Hand" ToolTip="Klik untuk memilih nama kemasan" PreviewMouseLeftButtonDown="UnitLookup_MouseLeftButtonDown" PreviewKeyDown="UnitLookup_KeyDown"/><TextBlock Grid.Row="1" Text="Isi tiap koli" VerticalAlignment="Center"/><TextBox x:Name="PackageSizeBox" Grid.Row="1" Grid.Column="1" Text="0" Margin="3,1" TextAlignment="Right"/><TextBlock Grid.Row="2" Text="Berat" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Text="0" Margin="3,1" TextAlignment="Right"/><DataGrid x:Name="PackageGrid" ItemsSource="{Binding Packages}" Visibility="Collapsed"/></Grid></GroupBox>
                <GroupBox Header="Stok &amp; HPP" Margin="0,0,0,4"><Grid Margin="5"><Grid.RowDefinitions><RowDefinition Height="23"/><RowDefinition Height="23"/><RowDefinition Height="23"/><RowDefinition Height="23"/><RowDefinition Height="23"/><RowDefinition Height="23"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="75"/><ColumnDefinition/><ColumnDefinition Width="62"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Stok Akhir" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="0" TextAlignment="Right" VerticalAlignment="Center"/><TextBlock Grid.Row="1" Text="HPP Standar" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ElementName=AverageCostBox, Path=Text}" IsReadOnly="True" TextAlignment="Right" Margin="3,1"/><TextBlock Grid.Row="2" Text="HPP / Sat." VerticalAlignment="Center"/><TextBlock Grid.Row="2" Grid.Column="1" Text="0" TextAlignment="Right" VerticalAlignment="Center"/><TextBlock Grid.Row="3" Text="HPP Total" VerticalAlignment="Center"/><TextBlock Grid.Row="3" Grid.Column="1" Text="0" TextAlignment="Right" VerticalAlignment="Center"/><TextBlock Grid.Row="4" Text="Min. Stok" VerticalAlignment="Center"/><TextBox x:Name="MinimumStockBox" Grid.Row="4" Grid.Column="1" Text="0" TextAlignment="Right" Margin="3,1"/><TextBlock Grid.Row="5" Text="Max. Stok" VerticalAlignment="Center"/><TextBox x:Name="MaximumStockBox" Grid.Row="5" Grid.Column="1" Text="0" TextAlignment="Right" Margin="3,1"/></Grid></GroupBox>
                <Button Content="Hapus Koli" HorizontalAlignment="Right" Padding="12,2" Click="RemovePackage_Click"/>
            </StackPanel>
        </Grid>
        <TextBlock x:Name="FooterHelpText" Grid.Row="3" Margin="3,0" VerticalAlignment="Center" Foreground="#444" Text="Isi data barang lalu tekan Simpan."/>
        <Grid Grid.Row="4" Margin="0,2,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button Content="&lt;&lt;" Width="37" Margin="2" IsEnabled="False"/><Button Content="&lt;" Width="37" Margin="2" IsEnabled="False"/><Button Content="•" Width="37" Margin="2" IsEnabled="False"/><Button Content="&gt;" Width="37" Margin="2" IsEnabled="False"/><Button Content="&gt;&gt;" Width="37" Margin="2" IsEnabled="False"/></StackPanel><Button Grid.Column="1" Content="Cari" Width="62" Margin="2" IsEnabled="False"/><Button Grid.Column="2" Content="Tambah" Width="70" Margin="2" IsEnabled="False"/><Button Grid.Column="3" Content="Batal" Width="70" Margin="2" Click="Close_Click"/><Button Grid.Column="4" Content="Simpan" Width="74" Margin="2" Click="Save_Click"/><Button Grid.Column="5" Content="Smnp&amp;Ctk" Width="82" Margin="2" Click="Save_Click"/><Button Grid.Column="6" Content="Hapus" Width="70" Margin="2" Click="Deactivate_Click"/><Button Grid.Column="7" Content="Btl.Hapus" Width="78" Margin="2" Click="Reactivate_Click"/><Button Grid.Column="8" Content="Tutup" Width="70" Margin="2" Click="Close_Click"/></Grid>
    </Grid>
</Window>
