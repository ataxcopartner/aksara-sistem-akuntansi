<UserControl x:Class="Aksara.Desktop.Views.GunggunganSalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Tahoma"
             FontSize="12">
    <UserControl.Resources>
        <Style x:Key="GunggunganButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#4B252A" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CDBDC0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="5,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="Background" Value="#F7E8EA" />
                                <Setter TargetName="ActionBorder" Property="BorderBrush" Value="#A64A57" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionBorder" Property="Background" Value="#EBCBD0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GunggunganPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource GunggunganButtonStyle}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#7C1622" />
            <Setter Property="BorderBrush" Value="#5C1018" />
        </Style>
        <Style x:Key="GunggunganDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource GunggunganButtonStyle}">
            <Setter Property="Foreground" Value="#A6192E" />
            <Setter Property="Background" Value="#FFF8F8" />
            <Setter Property="BorderBrush" Value="#E1B8BE" />
        </Style>
        <Style x:Key="GunggunganNavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource GunggunganButtonStyle}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,5,0" />
        </Style>
        <Style x:Key="GunggunganTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="Height" Value="28" />
            <Setter Property="BorderBrush" Value="#C8B8BC" />
            <Setter Property="Background" Value="White" />
        </Style>
        <Style x:Key="GunggunganReadOnlyBoxStyle" TargetType="TextBox" BasedOn="{StaticResource GunggunganTextBoxStyle}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Foreground" Value="#756568" />
            <Setter Property="Background" Value="#F6F1F2" />
            <Setter Property="BorderBrush" Value="#DDD2D4" />
        </Style>
        <Style x:Key="GunggunganDatePickerStyle" TargetType="DatePicker" BasedOn="{StaticResource {x:Type DatePicker}}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="28" />
            <Setter Property="BorderBrush" Value="#C8B8BC" />
        </Style>
        <Style x:Key="GunggunganComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="8,0,4,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#C8B8BC" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#6A111B" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Background" Value="#F0E3E5" />
            <Setter Property="BorderBrush" Value="#D4C0C4" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="BorderBrush" Value="#E7DDDF" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#35272A" />
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1"><Setter Property="Background" Value="#FCF8F9" /></Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#F4E1AA" />
                    <Setter Property="Foreground" Value="#3C2510" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GunggunganDataGridStyle" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#C9B9BC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="All" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E7DDDF" />
            <Setter Property="VerticalGridLinesBrush" Value="#DED0D3" />
            <Setter Property="AlternationCount" Value="2" />
            <Setter Property="RowHeight" Value="30" />
            <Setter Property="ColumnHeaderHeight" Value="32" />
        </Style>
        <Style x:Key="GunggunganPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D7C9CC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
    </UserControl.Resources>

    <Grid Background="#F7F3F4" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="12,8,12,4" Style="{StaticResource GunggunganPanelStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="245" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="175" />
                    <ColumnDefinition Width="235" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <CheckBox Content="Exclusive Mode" VerticalAlignment="Center" Margin="14,0,0,0" FontWeight="SemiBold" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,12,0">
                    <TextBlock Text="Status" Foreground="#806E71" VerticalAlignment="Center" />
                    <Rectangle Width="1" Height="18" Fill="#E2D7D9" Margin="14,0,0,0" />
                </StackPanel>
                <Border Grid.Column="2" Background="#F7E8EA" BorderBrush="#E7C9CE" BorderThickness="1" CornerRadius="3" Margin="6">
                    <TextBlock x:Name="ModeStatusText" Text="TAMBAH DATA" Foreground="#7C1622" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Grid.Column="3" Background="#FFF5DA" BorderBrush="#E8CA75" BorderThickness="1" CornerRadius="3" Margin="6">
                    <TextBlock x:Name="ServerStatusText" Text="TOTAL DATA 0" Foreground="#5A3B16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Grid.Column="4" BorderBrush="#E2D7D9" BorderThickness="1,0,0,0">
                    <Grid Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Rectangle Width="7" Height="7" Fill="#7C1622" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <Rectangle Width="7" Height="7" Fill="#D6A22E" HorizontalAlignment="Right" VerticalAlignment="Top" />
                        <Rectangle Width="7" Height="7" Fill="#D6A22E" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                        <Rectangle Width="7" Height="7" Fill="#7C1622" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="12,0,12,4">
            <TabItem Header="TRANSAKSI">
                <Grid Background="White" Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="75" /><ColumnDefinition Width="155" />
                            <ColumnDefinition Width="86" /><ColumnDefinition Width="150" />
                            <ColumnDefinition Width="76" /><ColumnDefinition Width="180" />
                            <ColumnDefinition Width="58" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tanggal" VerticalAlignment="Center" />
                        <DatePicker x:Name="DocumentDatePicker" Grid.Column="1" Style="{StaticResource GunggunganDatePickerStyle}" SelectedDateChanged="DocumentDatePicker_SelectedDateChanged" />
                        <TextBlock Grid.Column="2" Text="No. Nota" Margin="12,0,0,0" VerticalAlignment="Center" />
                        <TextBox x:Name="DocumentNumberBox" Grid.Column="3" Style="{StaticResource GunggunganReadOnlyBoxStyle}" />
                        <TextBlock Grid.Column="4" Text="Gudang" Margin="12,0,0,0" VerticalAlignment="Center" />
                        <ComboBox x:Name="WarehouseCombo" Grid.Column="5" Style="{StaticResource GunggunganComboBoxStyle}" DisplayMemberPath="Name" SelectedValuePath="Code" />
                        <TextBlock Grid.Column="6" Text="Kas" Margin="12,0,0,0" VerticalAlignment="Center" />
                        <ComboBox x:Name="CashAccountCombo" Grid.Column="7" Style="{StaticResource GunggunganComboBoxStyle}" DisplayMemberPath="Name" SelectedValuePath="Code" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="75" /><ColumnDefinition Width="*" /><ColumnDefinition Width="116" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Cari barang" VerticalAlignment="Center" />
                        <TextBox x:Name="ItemSearchBox" Grid.Column="1" Style="{StaticResource GunggunganTextBoxStyle}" KeyDown="ItemSearchBox_KeyDown" />
                        <Button Grid.Column="2" Content="Cari Barang" Margin="8,0,0,0" Style="{StaticResource GunggunganButtonStyle}" Click="FindItem_Click" />
                    </Grid>
                    <DataGrid x:Name="LinesGrid" Grid.Row="2" Style="{StaticResource GunggunganDataGridStyle}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" SelectionMode="Single"
                              CellEditEnding="LinesGrid_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kode Barang" Binding="{Binding ItemCode}" Width="125" IsReadOnly="True" />
                            <DataGridTextColumn Header="Nama Barang" Binding="{Binding ItemName}" Width="*" MinWidth="280" IsReadOnly="True" />
                            <DataGridTextColumn Header="Stok" Binding="{Binding AvailableStock, StringFormat={}{0:N2}}" Width="90" IsReadOnly="True" />
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                            <DataGridTextColumn Header="Sat." Binding="{Binding Unit}" Width="65" IsReadOnly="True" />
                            <DataGridTextColumn Header="Harga" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}" Width="125" />
                            <DataGridTextColumn Header="Jumlah" Binding="{Binding Total, StringFormat={}{0:N2}}" Width="135" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="3" Margin="0,9,0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="345" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="Tambah Barang" Width="104" Margin="0" Style="{StaticResource GunggunganButtonStyle}" Click="FindItem_Click" />
                            <Button Content="Hapus Baris" Width="96" Style="{StaticResource GunggunganButtonStyle}" Click="RemoveLine_Click" />
                            <TextBlock Text="Catatan" Margin="18,7,7,0" />
                            <TextBox x:Name="NotesBox" Width="300" Style="{StaticResource GunggunganTextBoxStyle}" />
                        </StackPanel>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions><RowDefinition Height="30" /><RowDefinition Height="30" /><RowDefinition Height="32" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="108" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="TOTAL" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                            <TextBox x:Name="TotalBox" Grid.Column="1" Style="{StaticResource GunggunganReadOnlyBoxStyle}" FontSize="16" FontWeight="Bold" TextAlignment="Right" />
                            <TextBlock Grid.Row="1" Text="Bayar tunai" VerticalAlignment="Center" />
                            <TextBox x:Name="CashReceivedBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource GunggunganTextBoxStyle}" FontSize="14" TextAlignment="Right" TextChanged="CashReceivedBox_TextChanged" />
                            <TextBlock Grid.Row="2" Text="KEMBALIAN" FontWeight="Bold" Foreground="#7C1622" VerticalAlignment="Center" />
                            <TextBox x:Name="ChangeBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource GunggunganReadOnlyBoxStyle}" FontSize="16" FontWeight="Bold" TextAlignment="Right" />
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="RIWAYAT &amp; CETAK RENTANG">
                <Grid Background="White" Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,8">
                        <TextBlock Text="Periode" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <DatePicker x:Name="FromDatePicker" Width="135" Style="{StaticResource GunggunganDatePickerStyle}" />
                        <TextBlock Text="s/d" VerticalAlignment="Center" Margin="7,0" />
                        <DatePicker x:Name="ToDatePicker" Width="135" Style="{StaticResource GunggunganDatePickerStyle}" />
                        <Button Content="Tampilkan" Width="92" Margin="8,0,0,0" Style="{StaticResource GunggunganButtonStyle}" Click="LoadReport_Click" />
                        <Button Content="Hari Ini" Width="82" Margin="12,0,0,0" Style="{StaticResource GunggunganButtonStyle}" Click="TodayPreset_Click" />
                        <Button Content="7 Hari Terakhir" Width="108" Style="{StaticResource GunggunganButtonStyle}" Click="SevenDaysPreset_Click" />
                        <Button Content="1 Bulan Terakhir" Width="118" Style="{StaticResource GunggunganButtonStyle}" Click="OneMonthPreset_Click" />
                        <Button Content="Bulan Ini" Width="86" Style="{StaticResource GunggunganButtonStyle}" Click="ThisMonthPreset_Click" />
                    </WrapPanel>
                    <Border Grid.Row="1" Background="#FAF4F5" BorderBrush="#D7C9CC" BorderThickness="1,1,1,0" Padding="10,7">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ReportTransactionCountText" FontWeight="Bold" /><TextBlock Text="   |   " Foreground="#806E71" />
                            <TextBlock x:Name="ReportQuantityText" FontWeight="Bold" /><TextBlock Text="   |   " Foreground="#806E71" />
                            <TextBlock x:Name="ReportSalesText" FontWeight="Bold" Foreground="#7C1622" />
                        </StackPanel>
                    </Border>
                    <DataGrid x:Name="ReportGrid" Grid.Row="2" Style="{StaticResource GunggunganDataGridStyle}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Single"
                              MouseDoubleClick="ReportGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tanggal" Binding="{Binding DocumentDate, StringFormat=dd/MM/yyyy}" Width="92" />
                            <DataGridTextColumn Header="No. Nota" Binding="{Binding DocumentNumber}" Width="125" />
                            <DataGridTextColumn Header="Kode Barang" Binding="{Binding ItemCode}" Width="110" />
                            <DataGridTextColumn Header="Nama Barang" Binding="{Binding ItemName}" Width="*" MinWidth="240" />
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, StringFormat={}{0:N2}}" Width="82" />
                            <DataGridTextColumn Header="Sat." Binding="{Binding Unit}" Width="62" />
                            <DataGridTextColumn Header="Harga" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" Width="112" />
                            <DataGridTextColumn Header="Jumlah" Binding="{Binding LineTotal, StringFormat={}{0:N2}}" Width="122" />
                            <DataGridTextColumn Header="Kas" Binding="{Binding CashAccountName}" Width="120" />
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="105" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="OpenSelectedButton" Content="Buka Data" Width="94" Margin="0" IsEnabled="False" Style="{StaticResource GunggunganButtonStyle}" Click="OpenSelected_Click" />
                            <Button x:Name="PrintSelectedButton" Content="Cetak Nota Terpilih" Width="132" IsEnabled="False" Style="{StaticResource GunggunganButtonStyle}" Click="PrintSelected_Click" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cetak Rentang" Width="112" Margin="0" Style="{StaticResource GunggunganButtonStyle}" Click="PrintRange_Click" />
                            <Button Content="Excel" Width="82" Style="{StaticResource GunggunganButtonStyle}" Click="ExportRange_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="12,9,12,5">
            <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource GunggunganNavigationButtonStyle}" Content="◀◀" Click="NavigateFirst_Click" ToolTip="Data pertama" />
                <Button Style="{StaticResource GunggunganNavigationButtonStyle}" Content="◀" Click="NavigatePrevious_Click" ToolTip="Data sebelumnya" />
                <Button Style="{StaticResource GunggunganNavigationButtonStyle}" Content="●" Click="NavigateLookup_Click" ToolTip="Pilih data" />
                <Button Style="{StaticResource GunggunganNavigationButtonStyle}" Content="▶" Click="NavigateNext_Click" ToolTip="Data berikutnya" />
                <Button Style="{StaticResource GunggunganNavigationButtonStyle}" Content="▶▶" Click="NavigateLast_Click" ToolTip="Data terakhir" />
            </StackPanel>
            <UniformGrid Grid.Column="1" Rows="1" Columns="8" HorizontalAlignment="Right" Width="792">
                <Button Style="{StaticResource GunggunganButtonStyle}" Click="Search_Click" ToolTip="ALT+I"><AccessText Text="Car_i" /></Button>
                <Button Style="{StaticResource GunggunganButtonStyle}" Click="Add_Click" ToolTip="ALT+A"><AccessText Text="T_ambah" /></Button>
                <Button Style="{StaticResource GunggunganButtonStyle}" Click="Cancel_Click" ToolTip="ALT+B"><AccessText Text="_Batal" /></Button>
                <Button x:Name="SaveButton" Style="{StaticResource GunggunganPrimaryButtonStyle}" Click="Save_Click" ToolTip="ALT+S"><AccessText Text="_Simpan" /></Button>
                <Button x:Name="SavePrintButton" Style="{StaticResource GunggunganButtonStyle}" Click="SavePrint_Click" ToolTip="ALT+K"><AccessText Text="Smpn&amp;Ct_k" /></Button>
                <Button x:Name="DeleteButton" Style="{StaticResource GunggunganDangerButtonStyle}" IsEnabled="False" Click="Delete_Click" ToolTip="ALT+H"><AccessText Text="_Hapus" /></Button>
                <Button x:Name="RestoreButton" Style="{StaticResource GunggunganButtonStyle}" IsEnabled="False" Click="Restore_Click" ToolTip="ALT+L"><AccessText Text="Bt_l.Hapus" /></Button>
                <Button Style="{StaticResource GunggunganButtonStyle}" Click="Close_Click" ToolTip="ALT+U"><AccessText Text="Tut_up" /></Button>
            </UniformGrid>
        </Grid>

        <Border Grid.Row="3" Background="#F7F3F4" BorderBrush="#D7C9CC" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Text="Siap." Margin="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</UserControl>
