<Window x:Class="Aksara.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AKSARA - Login"
        Width="520"
        Height="372"
        MinWidth="520"
        MinHeight="372"
        Icon="pack://application:,,,/Assets/aksara.ico"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F3EFF0"
        KeyDown="Login_KeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="LoginLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#4F3B3F" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="LoginTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#221315" />
            <Setter Property="BorderBrush" Value="#CBBCC0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="4,0,0,0" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#8F1022" />
                                <Setter TargetName="InputBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder" Property="Background" Value="#F1ECEE" />
                                <Setter Property="Foreground" Value="#8B777B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#221315" />
            <Setter Property="BorderBrush" Value="#CBBCC0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="4,0,0,0" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#8F1022" />
                                <Setter TargetName="InputBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder" Property="Background" Value="#F1ECEE" />
                                <Setter Property="Foreground" Value="#8B777B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginErrorPanelStyle" TargetType="Border">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Background" Value="#FFF7F7" />
            <Setter Property="BorderBrush" Value="#E4B9BF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=ErrorText}" Value="">
                    <Setter Property="Opacity" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LoginActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#5C1018" />
            <Setter Property="Background" Value="#FFFDFD" />
            <Setter Property="BorderBrush" Value="#D4C5C8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FFF4D2" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#D6A22E" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#8F1022" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FBE6A8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource LoginActionButtonStyle}">
            <Setter Property="Width" Value="108" />
            <Setter Property="Background" Value="#7C1622" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#5C1018" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#941E2E" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#D6A22E" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#5C1018" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="12"
            Background="#FFFDFD"
            BorderBrush="#CDBCC0"
            BorderThickness="1"
            CornerRadius="7">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="74" />
                <RowDefinition Height="*" />
                <RowDefinition Height="62" />
            </Grid.RowDefinitions>

            <Border Background="#7C1622" CornerRadius="6,6,0,0" Padding="18,11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36"
                            Height="36"
                            Background="#FFFDFD"
                            BorderBrush="#D6A22E"
                            BorderThickness="1"
                            CornerRadius="4"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/AKSARA;component/Assets/aksara-appicon.png"
                               Width="28"
                               Height="28"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="LoginBrandNameText"
                                   Text="AKSARA"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="White" />
                        <TextBlock Text="Sistem Akuntansi dan Administrasi"
                                   Margin="0,2,0,0"
                                   FontSize="10.5"
                                   Foreground="#F3DEE1" />
                    </StackPanel>
                    <Border x:Name="EnvironmentBadge"
                            Grid.Column="2"
                            Padding="9,3"
                            Background="#FFF4D2"
                            BorderBrush="#D6A22E"
                            BorderThickness="1"
                            CornerRadius="4"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="EnvironmentBadgeText"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#5C1018" />
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="22,13,22,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="17" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="17" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Nama pengguna" Style="{StaticResource LoginLabelStyle}" />
                <TextBox x:Name="UserNameText"
                         Grid.Row="1"
                         Style="{StaticResource LoginTextBoxStyle}"
                         AutomationProperties.Name="Nama pengguna" />

                <TextBlock Grid.Row="3" Text="Password" Style="{StaticResource LoginLabelStyle}" />
                <PasswordBox x:Name="PasswordText"
                             Grid.Row="4"
                             Style="{StaticResource LoginPasswordBoxStyle}"
                             AutomationProperties.Name="Password" />

                <Border Grid.Row="5"
                        Margin="0,9,0,0"
                        Style="{StaticResource LoginErrorPanelStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE7BA;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="#A6192E"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="ErrorText"
                                   Grid.Column="1"
                                   TextWrapping="Wrap"
                                   Foreground="#A6192E"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Background="#F9F6F7"
                    BorderBrush="#D8C9CC"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,6,6"
                    Padding="18,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText"
                                   Foreground="#705D61"
                                   Margin="0,0,12,0"
                                   TextWrapping="Wrap" />
                        <ProgressBar x:Name="LoginProgress"
                                     Width="112"
                                     Height="3"
                                     Margin="0,5,0,0"
                                     HorizontalAlignment="Left"
                                     IsIndeterminate="True"
                                     Foreground="#D6A22E"
                                     Background="#E8DEE0"
                                     Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="CloseButton"
                                Width="88"
                                Margin="0,0,8,0"
                                Style="{StaticResource LoginActionButtonStyle}"
                                Click="Close_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Text="Tutup" Margin="6,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="LoginButton"
                                IsDefault="True"
                                Style="{StaticResource LoginPrimaryButtonStyle}"
                                Click="Login_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8FB;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                                <TextBlock Text="Masuk" Margin="6,0,0,0" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
