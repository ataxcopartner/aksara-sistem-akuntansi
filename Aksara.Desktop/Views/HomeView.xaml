<UserControl x:Class="Aksara.Desktop.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Tahoma" FontSize="11" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Background="#F0F0F0">
        <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="*" /><RowDefinition Height="29" /></Grid.RowDefinitions>

        <Border Background="#F0F0F0" BorderBrush="#A0A0A0" BorderThickness="0,0,0,1">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="AKSARA - MENU UTAMA" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Mode Kompatibilitas CPS" VerticalAlignment="Center" Foreground="#444" />
            </Grid>
        </Border>

        <GroupBox Grid.Row="1" Header="Modul" Margin="10,9,10,8">
            <Grid Margin="8">
                <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>

                <Button Grid.Row="0" Grid.Column="0" Margin="5" Padding="10,6" Click="OpenModule_Click" Tag="Supplier">
                    <StackPanel><TextBlock Text="SUPPLIER" FontWeight="Bold" HorizontalAlignment="Center" /><TextBlock Text="Master Supplier dan Utang" HorizontalAlignment="Center" Foreground="#444" Margin="0,4,0,0" /></StackPanel>
                </Button>
                <Button Grid.Row="0" Grid.Column="1" Margin="5" Padding="10,6" Click="OpenModule_Click" Tag="Pembelian">
                    <StackPanel><TextBlock Text="PEMBELIAN" FontWeight="Bold" HorizontalAlignment="Center" /><TextBlock Text="Faktur, Retur dan Utang" HorizontalAlignment="Center" Foreground="#444" Margin="0,4,0,0" /></StackPanel>
                </Button>
                <Button Grid.Row="0" Grid.Column="2" Margin="5" Padding="10,6" Click="OpenModule_Click" Tag="Customer">
                    <StackPanel><TextBlock Text="CUSTOMER" FontWeight="Bold" HorizontalAlignment="Center" /><TextBlock Text="Master Customer dan Piutang" HorizontalAlignment="Center" Foreground="#444" Margin="0,4,0,0" /></StackPanel>
                </Button>
                <Button Grid.Row="1" Grid.Column="0" Margin="5" Padding="10,6" Click="OpenModule_Click" Tag="Kas Bank">
                    <StackPanel><TextBlock Text="KAS BANK" FontWeight="Bold" HorizontalAlignment="Center" /><TextBlock Text="Penerimaan dan Pembayaran" HorizontalAlignment="Center" Foreground="#444" Margin="0,4,0,0" /></StackPanel>
                </Button>
                <Button Grid.Row="1" Grid.Column="1" Margin="5" Padding="10,6" Click="OpenModule_Click" Tag="Barang">
                    <StackPanel><TextBlock Text="BARANG" FontWeight="Bold" HorizontalAlignment="Center" /><TextBlock Text="Persediaan, Stok dan HPP" HorizontalAlignment="Center" Foreground="#444" Margin="0,4,0,0" /></StackPanel>
                </Button>
                <Button Grid.Row="1" Grid.Column="2" Margin="5" Padding="10,6" Click="OpenModule_Click" Tag="Penjualan">
                    <StackPanel><TextBlock Text="PENJUALAN" FontWeight="Bold" HorizontalAlignment="Center" /><TextBlock Text="Nota, Retur dan Piutang" HorizontalAlignment="Center" Foreground="#444" Margin="0,4,0,0" /></StackPanel>
                </Button>
            </Grid>
        </GroupBox>

        <Border Grid.Row="2" Background="#F0F0F0" BorderBrush="#A0A0A0" BorderThickness="0,1,0,0" Padding="7,0">
            <TextBlock VerticalAlignment="Center" Text="Pilih tombol modul atau gunakan menu dan toolbar di jendela utama." />
        </Border>
    </Grid>
</UserControl>
