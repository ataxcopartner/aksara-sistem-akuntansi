<UserControl x:Class="Aksara.Desktop.Views.UnavailableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#F4F4F4" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
            <RowDefinition Height="42" />
        </Grid.RowDefinitions>
        <Border BorderBrush="#999" BorderThickness="1" Background="#EAEAEA" Padding="10,0">
            <TextBlock x:Name="HeadingText" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" />
        </Border>
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
            <TextBlock Text="Form ini sudah tercatat dalam inventarisasi CPS." FontSize="16" FontWeight="Bold" TextAlignment="Center" />
            <TextBlock Margin="0,12,0,0" Text="Struktur kolom, tombol, shortcut, validasi, dan integrasinya sedang direkonstruksi sebelum form diaktifkan." TextWrapping="Wrap" TextAlignment="Center" Foreground="#444" />
        </StackPanel>
        <Button Grid.Row="2" Content="Tutup" Width="100" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Close_Click" />
    </Grid>
</UserControl>
