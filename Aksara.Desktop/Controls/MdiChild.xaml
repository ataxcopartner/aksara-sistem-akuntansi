<UserControl x:Class="Aksara.Desktop.Controls.MdiChild"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="440" MinHeight="28" FontFamily="Tahoma" FontSize="11"
             UseLayoutRounding="True" SnapsToDevicePixels="True" Focusable="True"
             PreviewMouseDown="Root_PreviewMouseDown">
    <UserControl.Resources>
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="26" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="1,3" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionBackground" Property="Background" Value="#A53A49" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionBackground" Property="Background" Value="#5C1018" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,1,0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="0,7,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionBackground" Property="Background" Value="#C92A3D" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionBackground" Property="Background" Value="#A6192E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MaximizeCaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3">
                            <Grid Width="14" Height="14">
                                <Rectangle x:Name="MaximizeGlyph"
                                           Width="10" Height="10"
                                           Stroke="White" StrokeThickness="1.4"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Grid x:Name="RestoreGlyph" Visibility="Collapsed">
                                    <Rectangle Width="9" Height="8" Margin="0,1,1,0"
                                               Stroke="White" StrokeThickness="1.2"
                                               HorizontalAlignment="Right" VerticalAlignment="Top" />
                                    <Rectangle Width="9" Height="8" Margin="1,0,0,1"
                                               Fill="#7C1622" Stroke="White" StrokeThickness="1.2"
                                               HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Content" Value="❐">
                                <Setter TargetName="MaximizeGlyph" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="RestoreGlyph" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionBackground" Property="Background" Value="#A53A49" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionBackground" Property="Background" Value="#5C1018" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InvisibleThumbStyle" TargetType="Thumb">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="WindowRoot" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="TitleBorder" Grid.Row="0" Background="#7C1622"
                BorderBrush="#5C1018" BorderThickness="1,1,1,0" CornerRadius="8,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>

                <Thumb Grid.ColumnSpan="2" Style="{StaticResource InvisibleThumbStyle}" Cursor="SizeAll"
                       DragStarted="TitleDragThumb_DragStarted" DragDelta="TitleDragThumb_DragDelta"
                       MouseDoubleClick="TitleDragThumb_MouseDoubleClick" />
                <Image IsHitTestVisible="False"
                       Source="pack://application:,,,/Assets/aksara-appicon.png"
                       Width="23" Height="23" Stretch="Uniform"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock x:Name="TitleText" IsHitTestVisible="False" Grid.Column="1" VerticalAlignment="Center"
                           FontFamily="Tahoma" FontSize="12" FontWeight="SemiBold" Foreground="White"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="2" Style="{StaticResource CaptionButtonStyle}"
                        Click="Minimize_Click" ToolTip="Minimalkan">
                    <Rectangle Width="11" Height="1.5" Fill="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <Button x:Name="MaximizeButton" Grid.Column="3" Content="□"
                        Style="{StaticResource MaximizeCaptionButtonStyle}"
                        Click="Maximize_Click" ToolTip="Maksimalkan / pulihkan" />
                <Button Grid.Column="4" Style="{StaticResource CloseCaptionButtonStyle}"
                        Click="Close_Click" ToolTip="Tutup">
                    <Grid Width="13" Height="13">
                        <Path Data="M 2,2 L 11,11" Stroke="White" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Path Data="M 11,2 L 2,11" Stroke="White" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Grid>
                </Button>
            </Grid>
        </Border>

        <Border x:Name="ContentBorder" Grid.Row="1" Background="#FFFFFF"
                BorderBrush="#8E3542" BorderThickness="1" Padding="2,0,2,2" CornerRadius="0,0,8,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="18" />
                </Grid.RowDefinitions>
                <ContentPresenter x:Name="BodyPresenter" Grid.Row="0" />
                <Border Grid.Row="1" Background="#FFFFFF" Padding="0,0,12,2" IsHitTestVisible="False">
                    <TextBlock Text="Build and developped by andriawan tax consult."
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="9.5"
                               FontWeight="SemiBold"
                               Foreground="#5C1018"
                               Opacity="0.24"
                               TextAlignment="Right" />
                </Border>
            </Grid>
        </Border>

        <Thumb x:Name="RightResizeThumb" Grid.RowSpan="2" Width="4" HorizontalAlignment="Right"
               Cursor="SizeWE" Style="{StaticResource InvisibleThumbStyle}" DragDelta="RightResizeThumb_DragDelta" />
        <Thumb x:Name="BottomResizeThumb" Grid.RowSpan="2" Height="4" VerticalAlignment="Bottom"
               Cursor="SizeNS" Style="{StaticResource InvisibleThumbStyle}" DragDelta="BottomResizeThumb_DragDelta" />
        <Thumb x:Name="CornerResizeThumb" Grid.RowSpan="2" Width="12" Height="12"
               HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"
               Style="{StaticResource InvisibleThumbStyle}" DragDelta="CornerResizeThumb_DragDelta" />
    </Grid>
</UserControl>
