<Window x:Class="Aksara.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AKSARA - Sistem Akuntansi dan Administrasi"
        Icon="pack://application:,,,/Assets/aksara.ico"
        Height="820" Width="1360" MinHeight="680" MinWidth="1080"
        WindowStartupLocation="CenterScreen" WindowState="Maximized" Background="#F1EDEE"
        FontFamily="Tahoma" FontSize="11" UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <CubicEase x:Key="MenuZoomEaseOut" EasingMode="EaseOut" />

        <Style x:Key="MainMenuSeparatorStyle" TargetType="{x:Type Separator}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                        <Grid Height="9" SnapsToDevicePixels="True">
                            <Border Height="1"
                                    Margin="8,0"
                                    Background="#7C1622"
                                    Opacity="0.42"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="TopLevelMenuHeaderTemplate" TargetType="{x:Type MenuItem}">
            <Grid>
                <Border x:Name="MenuItemBorder"
                        MinHeight="25"
                        Margin="1,2"
                        Padding="9,3"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        CornerRadius="3">
                    <TextBlock Text="{TemplateBinding Header}"
                               Foreground="{TemplateBinding Foreground}"
                               FontSize="{TemplateBinding FontSize}"
                               FontWeight="{TemplateBinding FontWeight}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               SnapsToDevicePixels="False"
                               UseLayoutRounding="False"
                               TextOptions.TextFormattingMode="Ideal"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.CacheMode>
                            <BitmapCache RenderAtScale="1.25" />
                        </TextBlock.CacheMode>
                        <TextBlock.RenderTransform>
                            <ScaleTransform x:Name="TopLevelMenuScale" ScaleX="1" ScaleY="1" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Border>
                <Popup x:Name="PART_Popup"
                       Placement="Bottom"
                       AllowsTransparency="True"
                       Focusable="False"
                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                       PopupAnimation="Fade">
                    <Border Margin="0,3,0,0"
                            Padding="6"
                            MinWidth="190"
                            Background="#E0B84A"
                            BorderBrush="#8F1022"
                            BorderThickness="1"
                            CornerRadius="5"
                            SnapsToDevicePixels="True">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <EventTrigger RoutedEvent="Mouse.MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="TopLevelMenuScale" Storyboard.TargetProperty="ScaleX" To="1.015" Duration="0:0:0.18" EasingFunction="{StaticResource MenuZoomEaseOut}" />
                            <DoubleAnimation Storyboard.TargetName="TopLevelMenuScale" Storyboard.TargetProperty="ScaleY" To="1.015" Duration="0:0:0.18" EasingFunction="{StaticResource MenuZoomEaseOut}" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="Mouse.MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="TopLevelMenuScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15" EasingFunction="{StaticResource MenuZoomEaseOut}" />
                            <DoubleAnimation Storyboard.TargetName="TopLevelMenuScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15" EasingFunction="{StaticResource MenuZoomEaseOut}" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="MenuItemBorder" Property="Background" Value="#C79A2B" />
                    <Setter TargetName="MenuItemBorder" Property="BorderBrush" Value="#E8C967" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter TargetName="MenuItemBorder" Property="Background" Value="#C79A2B" />
                    <Setter TargetName="MenuItemBorder" Property="BorderBrush" Value="#E8C967" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="SubmenuItemTemplate" TargetType="{x:Type MenuItem}">
            <Border x:Name="SubmenuBorder"
                    MinHeight="27"
                    Margin="1"
                    Padding="10,5"
                    Background="#E0B84A"
                    CornerRadius="3">
                <Grid RenderTransformOrigin="0.5,0.5"
                      SnapsToDevicePixels="False"
                      UseLayoutRounding="False"
                      TextOptions.TextFormattingMode="Ideal">
                    <Grid.CacheMode>
                        <BitmapCache RenderAtScale="1.25" />
                    </Grid.CacheMode>
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="SubmenuItemScale" ScaleX="1" ScaleY="1" />
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{TemplateBinding Header}"
                               Foreground="{TemplateBinding Foreground}"
                               FontSize="{TemplateBinding FontSize}"
                               FontWeight="{TemplateBinding FontWeight}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{TemplateBinding InputGestureText}"
                               Margin="22,0,0,0"
                               Foreground="#221315"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <EventTrigger RoutedEvent="Mouse.MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="SubmenuItemScale" Storyboard.TargetProperty="ScaleX" To="1.012" Duration="0:0:0.18" EasingFunction="{StaticResource MenuZoomEaseOut}" />
                            <DoubleAnimation Storyboard.TargetName="SubmenuItemScale" Storyboard.TargetProperty="ScaleY" To="1.012" Duration="0:0:0.18" EasingFunction="{StaticResource MenuZoomEaseOut}" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="Mouse.MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="SubmenuItemScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15" EasingFunction="{StaticResource MenuZoomEaseOut}" />
                            <DoubleAnimation Storyboard.TargetName="SubmenuItemScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15" EasingFunction="{StaticResource MenuZoomEaseOut}" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="SubmenuBorder" Property="Background" Value="#8F1022" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#B49DA2" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="SubmenuHeaderTemplate" TargetType="{x:Type MenuItem}">
            <Grid>
                <Border x:Name="SubmenuHeaderBorder"
                        MinHeight="27"
                        Margin="1"
                        Padding="10,5"
                        Background="#E0B84A"
                        CornerRadius="3">
                    <Grid RenderTransformOrigin="0.5,0.5"
                          SnapsToDevicePixels="False"
                          UseLayoutRounding="False"
                          TextOptions.TextFormattingMode="Ideal">
                        <Grid.CacheMode>
                            <BitmapCache RenderAtScale="1.25" />
                        </Grid.CacheMode>
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="SubmenuHeaderScale" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{TemplateBinding Header}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="SubmenuArrow"
                                   Grid.Column="1"
                                   Text=">"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Foreground="#5C1018" />
                    </Grid>
                </Border>
                <Popup x:Name="PART_Popup"
                       Placement="Right"
                       HorizontalOffset="-2"
                       AllowsTransparency="True"
                       Focusable="False"
                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                       PopupAnimation="Fade">
                    <Border Margin="4,0,0,0"
                            Padding="6"
                            MinWidth="190"
                            Background="#E0B84A"
                            BorderBrush="#8F1022"
                            BorderThickness="1"
                            CornerRadius="5"
                            SnapsToDevicePixels="True">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <EventTrigger RoutedEvent="Mouse.MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="SubmenuHeaderScale" Storyboard.TargetProperty="ScaleX" To="1.012" Duration="0:0:0.18" EasingFunction="{StaticResource MenuZoomEaseOut}" />
                            <DoubleAnimation Storyboard.TargetName="SubmenuHeaderScale" Storyboard.TargetProperty="ScaleY" To="1.012" Duration="0:0:0.18" EasingFunction="{StaticResource MenuZoomEaseOut}" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="Mouse.MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="SubmenuHeaderScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15" EasingFunction="{StaticResource MenuZoomEaseOut}" />
                            <DoubleAnimation Storyboard.TargetName="SubmenuHeaderScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15" EasingFunction="{StaticResource MenuZoomEaseOut}" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="SubmenuHeaderBorder" Property="Background" Value="#8F1022" />
                    <Setter TargetName="SubmenuArrow" Property="Foreground" Value="White" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter TargetName="SubmenuHeaderBorder" Property="Background" Value="#8F1022" />
                    <Setter TargetName="SubmenuArrow" Property="Foreground" Value="White" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="MainMenuItemStyle" TargetType="{x:Type MenuItem}">
            <Setter Property="FontFamily" Value="Tahoma" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#221315" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template" Value="{StaticResource SubmenuItemTemplate}" />
            <Style.Triggers>
                <Trigger Property="Role" Value="TopLevelHeader">
                    <Setter Property="Template" Value="{StaticResource TopLevelMenuHeaderTemplate}" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontSize" Value="11.5" />
                    <Setter Property="FontWeight" Value="Bold" />
                </Trigger>
                <Trigger Property="Role" Value="TopLevelItem">
                    <Setter Property="Template" Value="{StaticResource TopLevelMenuHeaderTemplate}" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontSize" Value="11.5" />
                    <Setter Property="FontWeight" Value="Bold" />
                </Trigger>
                <Trigger Property="Role" Value="SubmenuHeader">
                    <Setter Property="Template" Value="{StaticResource SubmenuHeaderTemplate}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DashboardCardStyle" TargetType="{x:Type Border}">
            <Setter Property="Height" Value="260" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Background" Value="#FFFDFD" />
            <Setter Property="BorderBrush" Value="#DDC9CD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#C2AEB2" BlurRadius="8" ShadowDepth="1" Opacity="0.18" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashboardCardTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#282022" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DashboardValueStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,9,0,0" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#640915" />
        </Style>

        <Style x:Key="DashboardRefreshButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="72" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Foreground" Value="#5C1018" />
            <Setter Property="Background" Value="#FFF7E4" />
            <Setter Property="BorderBrush" Value="#C99B2A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F1D27A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#D8AD3A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarSectionTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="10,14,10,6" />
            <Setter Property="Foreground" Value="#F0C55D" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SidebarDividerStyle" TargetType="{x:Type Border}">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="10,0,10,4" />
            <Setter Property="Background" Value="#A84B58" />
            <Setter Property="Opacity" Value="0.55" />
        </Style>

        <Style x:Key="SidebarNavButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="6,0,6,4" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FFF7F8" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="120" />
            <Setter Property="ToolTipService.BetweenShowDelay" Value="0" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="NavButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavButtonBorder" Property="Background" Value="#D8AD3A" />
                                <Setter TargetName="NavButtonBorder" Property="BorderBrush" Value="#F4D875" />
                                <Setter Property="Foreground" Value="#351015" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavButtonBorder" Property="Background" Value="#C99B2A" />
                                <Setter Property="Foreground" Value="#250B0F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="MainMenuRow" Height="30" />
            <RowDefinition Height="*" />
            <RowDefinition Height="27" />
        </Grid.RowDefinitions>

        <Menu x:Name="MainMenu" Grid.Row="0" Background="#8F1022" BorderBrush="#5C1018" BorderThickness="0,0,0,1" Padding="5,1" ItemContainerStyle="{StaticResource MainMenuItemStyle}">
            <Menu.Resources>
                <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource MainMenuItemStyle}" />
                <Style TargetType="{x:Type Separator}" BasedOn="{StaticResource MainMenuSeparatorStyle}" />
                <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}" BasedOn="{StaticResource MainMenuSeparatorStyle}" />
            </Menu.Resources>
            <MenuItem x:Name="FileMenu" Header="File">
                <MenuItem Header="Close" InputGestureText="Ctrl+F4" Click="CloseActive_Click" />
                <MenuItem Header="Exit" InputGestureText="Alt+F4" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="Edit">
                <MenuItem Header="Cut" InputGestureText="Ctrl+X" Click="EditCommand_Click" Tag="Cut" />
                <MenuItem Header="Copy" InputGestureText="Ctrl+C" Click="EditCommand_Click" Tag="Copy" />
                <MenuItem Header="Paste" InputGestureText="Ctrl+V" Click="EditCommand_Click" Tag="Paste" />
                <Separator />
                <MenuItem Header="Select All" InputGestureText="Ctrl+A" Click="EditCommand_Click" Tag="SelectAll" />
            </MenuItem>
            <MenuItem Header="Ledger">
                <MenuItem Header="Daftar Perkiraan" Click="LedgerAccount_Click" />
                <MenuItem Header="Laporan"><MenuItem Header="Daftar Perkiraan" Click="LedgerReport_Click" Tag="AccountList" /></MenuItem>
                <Separator />
                <MenuItem Header="Jurnal Umum" Click="JournalEntry_Click" />
                <MenuItem Header="Laporan"><MenuItem Header="Jurnal Umum" Click="LedgerReport_Click" Tag="Journal" /></MenuItem>
                <Separator />
                <MenuItem Header="Laporan">
                    <MenuItem Header="Laporan Jurnal Awal" Click="LedgerReport_Click" Tag="OpeningJournal" />
                    <MenuItem Header="Laporan Jurnal Transaksi" Click="LedgerReport_Click" Tag="TransactionJournal" />
                    <MenuItem Header="Buku Besar" Click="LedgerReport_Click" Tag="GeneralLedger" />
                    <MenuItem Header="Neraca Saldo" Click="LedgerReport_Click" Tag="TrialBalance" />
                    <MenuItem Header="Laba Rugi" Click="LedgerReport_Click" Tag="IncomeStatement" />
                    <MenuItem Header="Neraca Skontro" Click="LedgerReport_Click" Tag="BalanceSheetSkontro" />
                    <MenuItem Header="Neraca Staffel" Click="LedgerReport_Click" Tag="BalanceSheetStaffel" />
                </MenuItem>
                <MenuItem Header="Penetapan Kode Perkiraan Jurnal Transaksi" Click="LedgerMapping_Click" />
            </MenuItem>
            <MenuItem Header="Kas Bank">
                <MenuItem Header="Daftar Kas" Click="CashBankMaster_Click" Tag="Cash" />
                <MenuItem Header="Daftar Bank" Click="CashBankMaster_Click" Tag="Bank" />
                <MenuItem Header="Daftar Biaya" Click="CashBankMaster_Click" Tag="Expense" />
                <MenuItem Header="Daftar Penghasilan Lain" Click="CashBankMaster_Click" Tag="Income" />
                <MenuItem Header="Laporan">
                    <MenuItem Header="Laporan Daftar Kas" Click="CashBankMaster_Click" Tag="Cash" />
                    <MenuItem Header="Laporan Daftar Bank" Click="CashBankMaster_Click" Tag="Bank" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Kas Bank" Click="CashBankTransaction_Click" Tag="Cash" />
                <MenuItem Header="Cek / Giro" Click="CustomerCheckGiro_Click" />
                <Separator />
                <MenuItem Header="Pembayaran Utang" Click="SupplierPayment_Click" />
                <MenuItem Header="Penerimaan Piutang" Click="CustomerReceipt_Click" />
            </MenuItem>
            <MenuItem Header="Supplier">
                <MenuItem Header="Daftar Supplier" Click="BusinessPartner_Click" Tag="Supplier" />
                <Separator />
                <MenuItem Header="Utang Awal" Click="SupplierOpeningBalance_Click" />
                <MenuItem Header="Koreksi Utang" Click="SupplierCorrection_Click" />
                <Separator />
                <MenuItem Header="Laporan">
                    <MenuItem Header="Laporan Utang Berjalan" Click="PartnerOutstandingReport_Click" Tag="SUPPLIER" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Pembelian">
                <MenuItem Header="Daftar Supplier" Click="BusinessPartner_Click" Tag="Supplier" />
                <Separator />
                <MenuItem Header="Pembelian" Click="ModuleMenu_Click" Tag="Pembelian" />
                <MenuItem Header="Retur Pembelian" Click="PurchaseReturn_Click" />
                <MenuItem Header="Laporan">
                    <MenuItem Header="Laporan Pembelian Rinci" Click="PurchaseReport_Click" Tag="Detail" />
                    <MenuItem Header="Laporan Pembelian Rinci (Header)" Click="PurchaseReport_Click" Tag="Header" />
                    <MenuItem Header="Laporan Retur Pembelian Rinci" Click="PurchaseReport_Click" Tag="ReturnDetail" />
                    <MenuItem Header="Laporan Retur Pembelian Header" Click="PurchaseReport_Click" Tag="ReturnHeader" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Customer">
                <MenuItem Header="Daftar Customer" Click="BusinessPartner_Click" Tag="Customer" />
                <MenuItem Header="Daftar Salesman" Click="BusinessPartner_Click" Tag="Salesman" />
                <Separator />
                <MenuItem Header="Piutang Awal" Click="CustomerOpeningBalance_Click" />
                <MenuItem Header="Koreksi Piutang" Click="CustomerCorrection_Click" />
                <Separator />
                <MenuItem Header="Laporan">
                    <MenuItem Header="Laporan Piutang Berjalan" Click="PartnerOutstandingReport_Click" Tag="CUSTOMER" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Penjualan">
                <MenuItem Header="Penjualan" Click="ModuleMenu_Click" Tag="Penjualan" />
                <MenuItem Header="Penjualan Gunggungan" Click="GunggunganSales_Click" />
                <MenuItem Header="Retur Penjualan" Click="SalesReturn_Click" />
                <MenuItem Header="Cek Harga Beli" Click="PurchasePriceCheck_Click" Tag="Sales" />
                <MenuItem Header="Laporan">
                    <MenuItem Header="Laporan Penjualan Rinci" Click="SalesReport_Click" Tag="Detail" />
                    <MenuItem Header="Laporan Penjualan Rinci (Header)" Click="SalesReport_Click" Tag="Header" />
                    <MenuItem Header="Laporan Retur Penjualan Rinci" Click="SalesReport_Click" Tag="ReturnDetail" />
                    <MenuItem Header="Laporan Retur Penjualan Header" Click="SalesReport_Click" Tag="ReturnHeader" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Laporan">
                    <MenuItem Header="Laporan Laba Penjualan Rinci" Click="SalesReport_Click" Tag="ProfitDetail" />
                    <MenuItem Header="Laporan Laba Penjualan Header" Click="SalesReport_Click" Tag="ProfitHeader" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Barang">
                <MenuItem Header="Daftar Lokasi Stok / Gudang Barang" Click="InventoryMaster_Click" Tag="Warehouses" />
                <Separator />
                <MenuItem Header="Daftar Kelompok Barang" Click="InventoryMaster_Click" Tag="Categories" />
                <MenuItem Header="Daftar Barang" Click="ModuleMenu_Click" Tag="Barang" />
                <MenuItem Header="Cek Harga Beli" Click="PurchasePriceCheck_Click" Tag="Inventory" />
                <Separator />
                <MenuItem Header="Mutasi Barang" Click="InventoryTransaction_Click" Tag="Transfer" />
                <MenuItem Header="Penyesuaian Persediaan" Click="InventoryTransaction_Click" Tag="Adjustment" />
                <MenuItem Header="Stok Fisik" Click="InventoryTransaction_Click" Tag="StockCount" />
                <MenuItem Header="Laporan">
                    <MenuItem Header="Laporan Mutasi Barang" Click="InventoryReport_Click" Tag="Transfers" />
                    <MenuItem Header="Penyesuaian Persediaan Semua" Click="InventoryReport_Click" Tag="AllAdjustments" />
                    <MenuItem Header="Saldo Awal" Click="InventoryReport_Click" Tag="OpeningBalance" />
                    <MenuItem Header="Penyesuaian" Click="InventoryReport_Click" Tag="Adjustments" />
                    <MenuItem Header="Stok Fisik" Click="InventoryReport_Click" Tag="StockCounts" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Laporan">
                    <MenuItem Header="Kartu Stok tanpa nilai" Click="InventoryReport_Click" Tag="StockCard" />
                    <MenuItem Header="Kartu Stok dengan nilai" Click="InventoryReport_Click" Tag="StockCardValue" />
                    <MenuItem Header="Persediaan lengkap" Click="InventoryReport_Click" Tag="Valuation" />
                    <MenuItem Header="Persediaan tanpa HPP" Click="InventoryReport_Click" Tag="ValuationNoCost" />
                    <MenuItem Header="Persediaan Min. Stok" Click="InventoryReport_Click" Tag="MinimumStock" />
                    <MenuItem Header="Persediaan Max. Stok" Click="InventoryReport_Click" Tag="MaximumStock" />
