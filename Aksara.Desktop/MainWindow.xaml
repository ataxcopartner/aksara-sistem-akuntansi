                                                </Grid>
                                                <TextBlock x:Name="CashFlowValueText" Grid.Row="1" Text="Rp 0" Style="{StaticResource DashboardValueStyle}" />
                                                <Canvas x:Name="CashFlowCanvas" Grid.Row="2" Margin="0,14,0,0" ClipToBounds="True" Background="Transparent" MouseLeftButtonUp="DashboardChart_Click" Tag="CashFlow" SizeChanged="DashboardChartCanvas_SizeChanged" />
                                                <TextBlock x:Name="CashFlowInfoText" Visibility="Collapsed" />
                                            </Grid>
                                        </Border>

                                        <Border Visibility="Collapsed" Style="{StaticResource DashboardCardStyle}">
                                            <Grid Margin="16,14">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Ketersediaan Arus Kas" Style="{StaticResource DashboardCardTitleStyle}" TextTrimming="CharacterEllipsis" />
                                                    <DockPanel Grid.Column="1" Margin="12,0,10,0" LastChildFill="False">
                                                        <TextBlock Text="Periode" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                                        <DatePicker x:Name="CashAvailabilityFromPicker" Width="98" Height="24" Margin="8,0,0,0" VerticalAlignment="Center" Tag="CashAvailability" SelectedDateChanged="DashboardPeriod_Changed" />
                                                        <TextBlock Text="s/d" Margin="6,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                                        <DatePicker x:Name="CashAvailabilityToPicker" Width="98" Height="24" VerticalAlignment="Center" Tag="CashAvailability" SelectedDateChanged="DashboardPeriod_Changed" />
                                                    </DockPanel>
                                                    <Button Grid.Column="2" Content="Refresh" Style="{StaticResource DashboardRefreshButtonStyle}" Tag="CashAvailability" Click="DashboardRefresh_Click" />
                                                </Grid>
                                                <TextBlock x:Name="CashAvailabilityValueText" Grid.Row="1" Text="Rp 0" Style="{StaticResource DashboardValueStyle}" />
                                                <Canvas x:Name="CashAvailabilityCanvas" Grid.Row="2" Margin="0,14,0,0" ClipToBounds="True" Background="Transparent" MouseLeftButtonUp="DashboardChart_Click" Tag="CashAvailability" SizeChanged="DashboardChartCanvas_SizeChanged" />
                                                <TextBlock x:Name="CashAvailabilityInfoText" Visibility="Collapsed" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>

                </Grid>
            </Border>
            <TextBlock Text="Build and developped by andriawan tax consult."
                       Grid.ColumnSpan="2"
                       IsHitTestVisible="False"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Margin="0,0,16,2"
                       FontSize="10.5"
                       FontWeight="SemiBold"
                       Foreground="#5C1018"
                       Opacity="0.26"
                       Panel.ZIndex="12"
                       TextAlignment="Right" />
            <Canvas x:Name="MdiCanvas" Grid.ColumnSpan="2" ClipToBounds="True" Panel.ZIndex="20" SizeChanged="MdiCanvas_SizeChanged" />
        </Grid>

        <Border Grid.Row="2" Background="#EEEEEE" BorderBrush="#9A9A9A" BorderThickness="0,1,0,0">
            <Grid Margin="7,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Text="AKSARA siap | Database: SERVER BELUM DIKONFIGURASI" Foreground="#333333" />
                <TextBlock x:Name="UserText" Grid.Column="1" Margin="15,0" VerticalAlignment="Center" Text="Pengguna: -" />
                <Border Grid.Column="2" BorderBrush="#B3B3B3" BorderThickness="1,0"><TextBlock Text="NUM" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <TextBlock x:Name="ClockText" Grid.Column="3" Margin="12,0,4,0" VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right" FontWeight="Bold" />
            </Grid>
        </Border>
    </Grid>
</Window>
